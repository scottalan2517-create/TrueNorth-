# Postgres connection string. On Railway, add a Postgres service and it
# will inject DATABASE_URL automatically. For local dev, point this at a
# local Postgres instance (e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/truenorth"

# Random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Stripe (test mode keys while building, live keys in Railway production env)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_COMPLETE=""
STRIPE_PRICE_PLUS=""
STRIPE_PRICE_PLUS_ANNUAL=""

# Resend — optional, powers Money Date reminder emails (Plus tier). Leave
# blank and reminders just don't send; nothing else breaks. Get a key at
# https://resend.com. EMAIL_FROM must be on a domain you've verified there.
RESEND_API_KEY=""
EMAIL_FROM=""

# Random string that authorizes calls to /api/cron/money-date-reminders.
# Generate the same way as SESSION_SECRET. Point an external scheduler
# (Railway's Cron Schedule on this service, or any free pinger like
# cron-job.org) at that URL once a day with header:
#   Authorization: Bearer <this value>
CRON_SECRET=""

# Plaid — optional, off by default, powers opt-in bank sync (Plus tier).
# Leave blank and the feature just doesn't appear; nothing else breaks.
# Get credentials at https://dashboard.plaid.com. Use "sandbox" while
# building, "production" once you're approved for real bank connections.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# 32-byte (64 hex char) key used to encrypt Plaid access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required if PLAID_CLIENT_ID/PLAID_SECRET are set — losing this key means
# every linked account needs to be reconnected, so store it somewhere safe.
PLAID_TOKEN_ENCRYPTION_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
